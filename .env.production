# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀（生产环境设置为完整后端地址）
VITE_API_URL = http://laravel-skel-pro.test

# Delete console
VITE_DROP_CONSOLE = true

# Reverb 生产环境配置
VITE_REVERB_APP_KEY = app-key
VITE_REVERB_HOST = laravel-skel-pro.test
VITE_REVERB_PORT = 443
VITE_REVERB_SCHEME = https
