# 【通用】环境变量

#  版本号
VITE_VERSION = 3.0.2

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

# ============== Laravel Reverb / Echo ==============
# Reverb 应用 Key（需与后端 REVERB_APP_KEY 一致）
VITE_REVERB_APP_KEY = app-key
# Reverb WebSocket 主机地址（开发环境与代理目标一致，生产环境填实际域名）
VITE_REVERB_HOST = laravel-skel-pro.test
# Reverb WebSocket 端口
VITE_REVERB_PORT = 8080
# 协议（生产环境用 https）
VITE_REVERB_SCHEME = http
